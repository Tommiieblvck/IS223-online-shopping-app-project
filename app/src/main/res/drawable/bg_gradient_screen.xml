<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#605FB4"
                android:endColor="#6A67C0"
                android:angle="270" />
        </shape>
    </item>
    <!-- Decorative background shape 1 (Top Right Glow) -->
    <item
        android:top="-120dp"
        android:right="-120dp">
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF" />
            <size android:width="300dp" android:height="300dp" />
        </shape>
    </item>
    <!-- Decorative background shape 2 (Bottom Left Glow) -->
    <item
        android:bottom="-150dp"
        android:left="-150dp">
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
            <size android:width="400dp" android:height="400dp" />
        </shape>
    </item>
</layer-list>
